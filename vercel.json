{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build -w @aihot/web && node deploy/vercel/bundle.mjs",
  "outputDirectory": "apps/web/build/client",
  "regions": ["syd1"],
  "functions": {
    "api/official-source.mjs": { "maxDuration": 30 },
    "api/radar.mjs": {
      "includeFiles": "{site/public/**,site/brand/**,site/pages/**,site/changelog.json,industry/*.json,industry/prompts/**,assets/og-fonts/**,modules/*/public/**,node_modules/harfbuzzjs/*.wasm}",
      "maxDuration": 60
    }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/api/radar" }
  ]
}
